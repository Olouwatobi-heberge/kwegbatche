# Code de la page /admin. 8 caractères minimum.
# Le lien de collecte est public : ne mettez pas ce code dans le message WhatsApp.
ADMIN_CODE=

# Supabase. Clé service_role, serveur seulement.
# Ne jamais la préfixer par NEXT_PUBLIC_ et ne jamais l'envoyer au navigateur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=recordings
SUPABASE_EXPORT_BUCKET=exports

# Sel pour hasher les adresses IP (recommandé en production).
RATE_LIMIT_SALT=

# Quotas optionnels. Défauts dans src/lib/limits.ts.
# COLLECT_LIMIT_IP_PER_MIN=60
# COLLECT_LIMIT_IP_PER_HOUR=500
# COLLECT_LIMIT_SPEAKER_PER_MIN=20
# COLLECT_LIMIT_SPEAKER_PER_HOUR=150
# COLLECT_LIMIT_LOGIN_PER_15MIN=15
